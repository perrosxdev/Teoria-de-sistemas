{UTF-8}
Inventario Objetivo=IF THEN ELSE(Vehiculo comprado = 1, 2000, 850)
	~	Caja
	~		|

Mercado potencial=1200
	~	Caja/Month
	~		|

Clientes potenciales Restantes=MAX(0, Mercado potencial - Demanda Base)
	~	Caja/Month
	~		|

Tasa de captacion=Demanda Base * Tasa de crecimiento base * Fraccion de mercado Disponible
	~	Caja/Month
	~		|

Fraccion de mercado Disponible=Clientes potenciales Restantes/Mercado potencial
	~	Dmnl
	~		|

Gatillo reactivo=IF THEN ELSE(
	        Margen acumulado > Costo de vehiculo :AND: Tasa de incumplimiento > 0.1,
	        1, 0 )
	~	Dmnl
	~		|

Capacidad maxima proveedor=1500
	~	Caja/Month
	~		|

Demanda minima=200
	~	Caja/Month
	~		|

Demanda total=Demanda Base*Estacionalidad
	~	Caja/Month
	~		|

Disponibilidad proveedor = WITH LOOKUP (MODULO ( Tiempo , 12 ),
		([(0,0)-(25,2)],(0,0.8), (1,0.8), (2,1), (3,1), (4,1), (5,1), (6,1), (7,1), (8,1), \
		(9,1), (10,1), (11,1), (12,0.8), (13,0.8), (14,1), (15,1), (16,1), (17,1), (18,1), \
		(19,1), (20,1), (21,1), (22,1), (23,1), (24,0.8)))
	~	Dmnl
	~		|

Necesidad de compra=MAX(0, Inventario Objetivo - Stock de huevos)
	~	Caja
	~		|

Paso de tiempo=1
	~	Month
	~		|

Gatillo proactivo=IF THEN ELSE(Tiempo >= Mes de compra, 1, 0)
	~	Dmnl
	~		|

Pulso de compra=IF THEN ELSE(
	        Gatillo Activo = 1 :AND: Vehiculo comprado < 1,
	        1/Paso de tiempo,
	        0 )
	~	Dmnl/Month
	~		|

Tasa de perdida de clientes=IF THEN ELSE(Demanda Base > Demanda minima, Demanda Base \
		* Tasa de fuga logistica, 0)
	~	Caja/Month
	~		|

Estacionalidad = WITH LOOKUP (MODULO ( Tiempo , 12 ) ,
		([(0,0)-(24,2)],(0,1.84), (1,1.81), (2,0.84), (3,0.78), (4,0.9), (5,0.75), (6,0.84)\
		, (7,0.67), (8,0.69), (9,0.91), (10,0.71), (11,1.27)))
	~	Dmnl
	~		|

Tasa de despacho=MIN( Capacidad Reparto, MIN( Demanda total, Stock de huevos/ Paso de tiempo\
		) )
	~	Caja/Month
	~		|

Tasa de despacho sin camion=MIN( Capacidad inicial sin camion, MIN( Demanda total, Stock de huevos\
		/ Paso de tiempo ) )
	~	Caja/Month
	~		|

Ventas adicionales por camion=MAX(0, Tasa de despacho - Tasa de despacho sin camion)
	~	Caja/Month
	~		|

Tiempo= INTEG ( 1,
		 0)
	~	Month
	~		|

Tasa de compra=MIN(Necesidad de compra, Disponibilidad proveedor * Capacidad maxima proveedor\
		)
	~	Caja/Month
	~		|

Capacidad Reparto= INTEG (Inversion en capacidad*Incremento capacidad por CLP,
		720)
	~	Caja/Month
	~		|

Capacidad inicial sin camion=720
	~	Caja/Month
	~		|

Costo de compra=Tasa de compra*Precio de compra
	~	CLP/Month
	~		|

Costo de vehiculo=5e+07
	~	CLP
	~		|

Costo fijo mantenimiento=200
	~	CLP/(Caja/Month)/Month
	~		|

Costo variable reparto=500
	~	CLP/Caja
	~		|

Costo operacional camion=150
	~	CLP/Caja
	~		|

Costo operacional camion mensual=IF THEN ELSE(Vehiculo comprado >= 1, Ventas adicionales por camion\
		 * Costo operacional camion, 0)
	~	CLP/Month
	~		|

Costos fijos mensuales=100000 + (Capacidad Reparto - 867) * Costo fijo mantenimiento
	~	CLP/Month
	~		|

Mantenimiento extra por camion=(Capacidad Reparto - Capacidad inicial sin camion) * Costo fijo mantenimiento
	~	CLP/Month
	~		|

Beneficio neto por camion=Ventas adicionales por camion * (Precio de venta - Precio de compra\
		 - Costo variable reparto) - Mantenimiento extra por camion - Costo operacional camion mensual
	~	CLP/Month
	~		|

Costos operacionales=Costos fijos mensuales + (Tasa de despacho * Costo variable reparto\
		) + Costo operacional camion mensual
	~	CLP/Month
	~		|

Demanda Base= INTEG (Tasa de captacion - Tasa de perdida de clientes,
		700)
	~	Caja/Month
	~		|

Gatillo Activo=    IF THEN ELSE( Politica proactiva = 2, Gatillo proactivo,
	        IF THEN ELSE( Politica proactiva = 1, Gatillo reactivo, 0 ) )
	~	Dmnl
	~		|

Incremento capacidad por CLP=4.328e-05
	~	(Caja/Month)/CLP
	~		|

Ingresos por ventas=Tasa de despacho*Precio de venta
	~	CLP/Month
	~		|

Inversion en capacidad=Pulso de compra*Costo de vehiculo
	~	CLP/Month
	~		|

Margen acumulado= INTEG (Ingresos por ventas - (Costo de compra + Costos operacionales\
		 + Inversion en capacidad),
		1.2e+07)
	~	CLP
	~		|

Mes de compra=8
	~	Month
	~		|

Politica proactiva=2
	~	Dmnl
	~		|

Precio de compra=24000
	~	CLP/Caja
	~		|

Precio de venta=33000
	~	CLP/Caja
	~		|

Stock de huevos= INTEG (Tasa de compra-Tasa de despacho,
		750)
	~	Caja
	~		|

Tasa de crecimiento base=0.02
	~	1/Month
	~		|

Tasa de fuga logistica = WITH LOOKUP (Tasa de incumplimiento,
		([(0,0)-(0.5,0.3)],(0,0), (0.1,0.02), (0.3,0.1), (0.5,0.25), (0.7,0.3), (1,0.32)))
	~	Dmnl
	~		|

Tasa de incumplimiento= MAX( 0, (Demanda total - Tasa de despacho) / Demanda total )
	~	Dmnl
	~		|

Vehiculo comprado= INTEG (Pulso de compra,
		0)
	~	Dmnl
	~		|

Beneficio acumulado por camion= INTEG (IF THEN ELSE(Vehiculo comprado >= 1, Beneficio neto por camion\
		, 0),
		0)
	~	CLP
	~		|

ROI camion=IF THEN ELSE(Vehiculo comprado >= 1, Beneficio acumulado por camion / Costo de vehiculo\
		, 0)
	~	Dmnl
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 300
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

