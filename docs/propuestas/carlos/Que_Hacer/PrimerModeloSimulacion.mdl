{UTF-8}
Capacidad de Inversion=IF THEN ELSE ( Margen Acumulado > Umgral de Inversion , 1 , 0 \
		)
	~	
	~		|

Capacidad de Reparto= INTEG (Inversion En capacidad,
		200)
	~	
	~		|

Costo de compra=Tasa de Compra*Precio Proveedor
	~	
	~		|

Costos Operacionales=3e+06
	~	
	~		|

Costos Totales=Costo de compra+Costos Operacionales
	~	
	~		|

Demanda Base=220
	~	
	~		|

Demanda Total=Demanda Base*Estacionalidad
	~	
	~		|

Disponibilidad Proveedor = WITH LOOKUP (Mes,
		([(0,0)-(24,1.1)],
		(0,0.8),(1,0.8),(2,1),(3,1),(4,1),(5,1),
		(6,1),(7,1),(8,1),(9,1),(10,1),(11,0.9),
		(12,0.8),(13,0.8),(14,1),(15,1),(16,1),(17,1),
		(18,1),(19,1),(20,1),(21,1),(22,1),(23,0.9),
		(24,0.8)))
	~	
	~		|

Estacionalidad = WITH LOOKUP (Mes,
		([(0,0)-(24,2)],
		(0,1.8),(1,1.7),(2,0.8),(3,0.7),(4,0.8),(5,0.7),
		(6,0.75),(7,0.6),(8,0.65),(9,0.85),(10,0.75),
		(11,1.2),(12,1.8),(13,1.7),(14,0.8),(15,0.7),
		(16,0.8),(17,0.7),(18,0.75),(19,0.6),(20,0.65),
		(21,0.85),(22,0.75),(23,1.2),(24,1.8)))
	~	Dmnl
	~		|

Ingresos por ventas=MIN ( Tasa de Despacho , Precio de venta )
	~	
	~		|

Inventario Objetivo=1000
	~	
	~		|

Inversion En capacidad=Capacidad de Inversion*Tasa de expansion
	~	
	~		|

Margen Acumulado= INTEG (Ingresos por ventas-Costos Totales,
		0)
	~	
	~		|

Mes=0
	~	
	~		|

Necedidad De compra=MAX(0,Inventario Objetivo - Stock de huevos)
	~	
	~		|

Precio de venta=50000
	~	
	~		|

Precio Proveedor=42000
	~	
	~		|

Stock de huevos= INTEG (Tasa de Compra-Tasa de Despacho,
		1000)
	~	
	~		|

Tasa de Compra=MIN( Necedidad De compra,
	    Disponibilidad Proveedor * Demanda Total
	)
	~	
	~		|

Tasa de Despacho=MIN ( Stock de huevos , Capacidad de Reparto )
	~	
	~		|

Tasa de expansion=50
	~	
	~		|

Umgral de Inversion=3e+06
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 24
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Day [0,?]
	~	The time step for the simulation.
	|

